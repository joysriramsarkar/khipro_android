<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/key_ripple"
    android:radius="6dp">
    <item>
        <layer-list>
            <!-- Bottom shadow -->
            <item
                android:left="0.5dp"
                android:right="0.5dp"
                android:top="1dp">
                <shape>
                    <solid android:color="@color/special_key_shadow" />
                    <corners android:radius="8dp" />
                </shape>
            </item>
            <!-- Main surface -->
            <item android:bottom="1.5dp">
                <shape>
                    <solid android:color="@color/special_key_surface" />
                    <corners android:radius="8dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
