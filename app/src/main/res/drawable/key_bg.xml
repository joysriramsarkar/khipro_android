<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#4D000000"> <!-- Darker Ripple -->
    <item>
        <layer-list>
            <!-- Shadow effect at the bottom -->
            <item android:top="1dp" android:left="0.2dp" android:right="0.2dp">
                <shape>
                    <solid android:color="#BCC1C6" />
                    <corners android:radius="7dp" />
                </shape>
            </item>
            <!-- Main Key Surface -->
            <item android:bottom="1.5dp">
                <shape>
                    <solid android:color="#FFFFFF" />
                    <corners android:radius="7dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>